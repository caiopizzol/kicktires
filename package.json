{
  "name": "kicktires",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "eve build",
    "review": "bun src/cli.ts",
    "test": "bun test tests",
    "check": "vp check && bun run typecheck && bun run test",
    "sandbox": "docker build -t kicktires-sandbox:0.1.0 -f Dockerfile.sandbox .",
    "format": "vp fmt",
    "test:integration": "bun tests/integration/review.ts",
    "doctor": "bun --no-env-file scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "prepare": "test ! -x node_modules/.bin/vp || vp config --no-agent"
  },
  "dependencies": {
    "@openai/codex": "0.154.0",
    "eve": "0.52.5",
    "yaml": "2.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.13",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/bun": "1.3.12",
    "@types/express": "5.0.6",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=24"
  }
}
